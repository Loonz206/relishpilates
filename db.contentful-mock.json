    {
      "id": "terms-item-1",
      "content_type": "policyItem",
      "fields": {
        "title": { "en-US": "Acceptance of Terms" },
        "body": {
          "en-US": "By booking a session or using our website, you agree to these terms and conditions. If you do not agree with any part of these terms, you may not use our services."
        }
      }
    },
    {
      "id": "terms-item-2",
      "content_type": "policyItem",
      "fields": {
        "title": { "en-US": "Session Cancellation & Rescheduling" },
        "body": {
          "en-US": "You may reschedule or cancel your session with at least 24 hours notice. Cancellations made less than 24 hours before your scheduled session may result in forfeiture of that session. No refunds are provided for cancellations outside the rescheduling window."
        }
      }
    },
    {
      "id": "terms-item-3",
      "content_type": "policyItem",
      "fields": {
        "title": { "en-US": "Session Packages" },
        "body": {
          "en-US": "Session packages expire 6 months from the purchase date. Unused sessions after the expiration date will be forfeited. Session pricing does not include applicable taxes. All prices are subject to change without notice."
        }
      }
    },
    {
      "id": "terms-item-4",
      "content_type": "policyItem",
      "fields": {
        "title": { "en-US": "Assumption of Risk" },
        "body": {
          "en-US": "Pilates is a physical activity. You acknowledge that participating in our sessions involves inherent risks. You assume all risks associated with your participation and agree to release Relish Pilates from any liability for injuries or damages."
        }
      }
    },
    {
      "id": "terms-item-5",
      "content_type": "policyItem",
      "fields": {
        "title": { "en-US": "Medical Consultation" },
        "body": {
          "en-US": "Before starting any new exercise program, including Pilates, consult with a healthcare professional if you have any pre-existing medical conditions, injuries, or concerns. Relish Pilates is not a substitute for medical advice."
        }
      }
    },
    {
      "id": "terms-item-6",
      "content_type": "policyItem",
      "fields": {
        "title": { "en-US": "Liability Limitation" },
        "body": {
          "en-US": "Relish Pilates shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising from your use of our services. Our liability is limited to the amount you paid for your sessions."
        }
      }
    },
    {
      "id": "terms-item-7",
      "content_type": "policyItem",
      "fields": {
        "title": { "en-US": "User Conduct" },
        "body": {
          "en-US": "You agree to use our services in compliance with all applicable laws and regulations. You will not engage in any conduct that is harmful, threatening, abusive, or otherwise violates the rights of others."
        }
      }
    },
    {
      "id": "terms-item-8",
      "content_type": "policyItem",
      "fields": {
        "title": { "en-US": "Changes to Terms" },
        "body": {
          "en-US": "We reserve the right to modify these terms at any time. Changes will be effective immediately upon posting to our website. Your continued use of our services constitutes acceptance of any modifications."
        }
      }
    },
