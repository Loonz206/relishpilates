    {
      "id": "home-page-1",
      "content_type": "homePage",
      "fields": {
        "metadataTitle": { "en-US": "Relish Pilates - Yummy, challenging, feel-good Pilates" },
        "metadataDescription": {
          "en-US": "Virtual Pilates classes built entirely around you. With custom programming and personal attention, every movement connects to how you want to move and feel."
        },
        "hero": {
          "en-US": {
            "heading": { "en-US": "Yummy, challenging, feel-good Pilates" },
            "paragraphs": {
              "en-US": [
                {
                  "en-US": "Virtual Pilates classes built entirely around you. With custom programming and personal attention, every movement connects to how you want to move and feel."
                },
                {
                  "en-US": "Join me in building strength, awakening flexibility, and moving through life with more freedom and ease."
                },
                { "en-US": "Haven't tried Pilates before? Welcome!" }
              ]
            },
            "cta": {
              "en-US": {
                "label": { "en-US": "Book a session" },
                "href": { "en-US": "#schedule" }
              }
            },
            "images": {
              "en-US": {
                "welcomeAlt": { "en-US": "Relish Pilates welcome" },
                "mermaidAlt": { "en-US": "Pilates mermaid pose" },
                "legPullBackAlt": { "en-US": "Pilates leg pull back" }
              }
            }
          }
        },
        "about": {
          "en-US": {
            "heading": { "en-US": "Strengthen. Stretch. Savor." },
            "paragraphs": {
              "en-US": [
                {
                  "en-US": "Relish Pilates is all about sharing movement as a powerful and nourishing way to connect to yourself."
                },
                {
                  "en-US": "With a personal guide designing, leading and adapting your workout as you move, you get the most out of every moment."
                },
                {
                  "en-US": "And you can have some time that's truly all about you, what you want for your body and how you want to feel in it."
                }
              ]
            }
          }
        },
        "steps": {
          "en-US": {
            "eyebrow": { "en-US": "How to Relish" },
            "heading": { "en-US": "Ready to Pilates" },
            "cta": {
              "en-US": {
                "label": { "en-US": "Book a session" },
                "href": { "en-US": "#schedule" }
              }
            },
            "items": {
              "en-US": [
                {
                  "number": { "en-US": "1" },
                  "title": { "en-US": "Schedule a good time" },
                  "bullets": {
                    "en-US": [
                      { "en-US": "Book a time for your Pilates workout" },
                      { "en-US": "Each session is 55-60 minutes" },
                      { "en-US": "Create an account so you can make changes just in case" },
                      { "en-US": "Check your confirmation email for everything you need" }
                    ]
                  }
                }
              ]
            }
          }
        }
      }
